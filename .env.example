# Public — safe to expose to the browser (also set these in Vercel's
# Environment Variables, with the same names, exactly as shown here).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — server-only. NEVER prefix this with NEXT_PUBLIC_, and never
# commit a real value to git. Used by scripts/provision.js and any
# server-side admin actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
